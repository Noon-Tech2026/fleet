# --- Base de donnees MySQL -----------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=fleet
DB_PASSWORD=changeme
DB_NAME=fleet
DB_LOGGING=false

# --- Authentification ----------------------------------------------------
# Generer une valeur unique : openssl rand -base64 48
# Changer ce secret invalide toutes les sessions ouvertes.
JWT_SECRET=

# Compte administrateur initial (script `npm run seed`).
# Laisser ADMIN_PASSWORD vide pour qu'un mot de passe soit genere.
ADMIN_EMAIL=admin@fleet.local
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=

# --- Source de telemetrie -------------------------------------------------
# simulator = donnees fabriquees, aucun materiel requis
# traccar   = connexion reelle au serveur Traccar
TELEMETRY_SOURCE=simulator

TRACCAR_URL=http://traccar:8082
TRACCAR_USER=admin@example.com
TRACCAR_PASSWORD=changeme

# --- API ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
